[Unit]
Description=1Panel multi-node master gateway
After=network-online.target 1panel-core.service
Wants=network-online.target

[Service]
Type=simple
# State: /var/lib/1pm/master.json (tunnel token auto; panel user/entrance from core.db).
# Only secret you may need once: 1pm master set --panel-pass P
# Do NOT put secrets on ExecStart.
ExecStart=/usr/local/bin/1pm master
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
