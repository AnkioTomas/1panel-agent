[Unit]
Description=1Panel multi-node agent tunnel
After=network-online.target 1panel-core.service
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/root
# This unit is written by Master /agent.sh — do not hardcode token here.
# Install: curl -fsSL "http://<master>:<port>/agent.sh?token=<token>" | sudo bash
ExecStart=/usr/local/bin/1pm agent run
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
