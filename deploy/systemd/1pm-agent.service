[Unit]
Description=1Panel multi-node agent tunnel
After=network-online.target 1panel-core.service
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/root
# Install: open Master UI and copy the signed curl (timestamp+sign, ~5 min TTL).
ExecStart=/usr/local/bin/1pm agent run
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
