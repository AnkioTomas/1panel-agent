[Unit]
Description=1Panel multi-node agent tunnel
After=network-online.target 1panel-core.service
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/root
# Prefer one-shot install from Master:
#   curl -fsSL "http://<master>:<port>/agent.sh?token=<token>" | sudo bash
ExecStart=/usr/local/bin/1pm agent register 10.211.55.14:52045/mp-tunnel-secret
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
